# Paseo Macuto - Variables de Entorno
# Duplica este archivo como .env

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto-ref.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# Conexión Directa a PostgreSQL (Supabase)
SUPABASE_DB_HOST=db.tu-proyecto-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=tu_contraseña_de_bd_aqui
